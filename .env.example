# Supabase browser and server configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Existing application configuration
DATABASE_URL=
JWT_SECRET=

# Bitcoin deposits. Keep all values server-side except the network label shown by the UI.
BTC_NETWORK=mainnet
BTC_REQUIRED_CONFIRMATIONS=3
# Comma-separated, pre-generated addresses from your custody/wallet provider.
# Use mainnet addresses while BTC_NETWORK=mainnet and never mix networks.
BTC_DEPOSIT_ADDRESS_POOL=
# Optional CoinGecko demo API key for higher rate limits.
COINGECKO_API_KEY=
